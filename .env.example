# === CONFIG GENERAL ===
LOG_LEVEL=INFO
ENVIRONMENT=production

# === REDDIT (https://www.reddit.com/prefs/apps - tipo 'script') ===
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ArgentinaInsights/1.0 by /u/tu_usuario

# === YOUTUBE DATA API v3 (opcional, si querés usar API oficial) ===
YOUTUBE_API_KEY=

# === TELEGRAM SCRAPER (https://my.telegram.org -> API development tools) ===
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=+5491150000000

# === TELEGRAM BOT PARA ALERTAS ===
# Crear bot con @BotFather, copiar token. Hablale al bot con /start.
# Tu chat_id: https://api.telegram.org/bot<TOKEN>/getUpdates o usar @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_CHAT_ID=

# === OLLAMA (NLP local) ===
# Si Ollama corre en el host del Docker: usar host.docker.internal
# Si corre en otro container del mismo compose: nombre del servicio
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_ENABLED=true
OLLAMA_TIMEOUT_SEC=30

# === PLAYWRIGHT - REDES SOCIALES (TIER 4 - OPCIONAL Y RIESGOSO) ===
ENABLE_INSTAGRAM_SCRAPING=false
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

ENABLE_TWITTER_SCRAPING=false
TWITTER_USERNAME=
TWITTER_PASSWORD=

ENABLE_TIKTOK_SCRAPING=true

# === PROXIES (recomendado para Tier 4) ===
USE_PROXY=false
PROXY_URL=

# === SCRAPING BEHAVIOR ===
HEADLESS=true
MIN_DELAY_SEC=3
MAX_DELAY_SEC=8
MAX_RETRIES=3
